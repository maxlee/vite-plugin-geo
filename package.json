{
  "name": "vite-plugin-geo",
  "version": "0.1.5",
  "$schema": "https://raw.githubusercontent.com/vitejs/vite-plugin-registry/refs/heads/main/data/schema/extended-package-json.schema.json",
  "description": "Vite plugin to generate sitemap.xml, llms.txt, robots.txt, and optional GEO companion files.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "bin": "./cli.js",
  "exports": {
    ".": "./index.js",
    "./astro": {
      "types": "./astro.d.ts",
      "import": "./astro.js",
      "default": "./astro.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "pack:dry-run": "npm_config_cache=/tmp/slinedev-npm-cache npm pack --dry-run --json",
    "verify:consumers": "node scripts/verify-consumer-matrix.mjs",
    "verify:registry-metadata": "node scripts/verify-registry-metadata.mjs"
  },
  "files": [
    "README.md",
    "astro.js",
    "astro.d.ts",
    "index.js",
    "index.d.ts",
    "cli.js",
    "viteGeoGeneratorPlugin.js",
    "geoBuildPipeline.js",
    "geoAudit.js",
    "astroSitemapCompatibility.js",
    "geoGenerator.js",
    "geoMetadataResolver.js"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "geo",
    "seo",
    "sitemap",
    "robots",
    "llms",
    "sku.md"
  ],
  "author": "maxlee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxlee/vite-plugin-geo.git"
  },
  "bugs": {
    "url": "https://github.com/maxlee/vite-plugin-geo/issues"
  },
  "homepage": "https://github.com/maxlee/vite-plugin-geo#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "compatiblePackages": {
    "schemaVersion": 1,
    "vite": {
      "type": "compatible",
      "versions": "^7.0.0 || ^8.0.0"
    },
    "rollup": {
      "type": "unknown"
    },
    "rolldown": {
      "type": "unknown"
    }
  },
  "dependencies": {
    "parse5": "8.0.1",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.2.8",
    "vite7": "npm:vite@7.3.6",
    "vite8": "npm:vite@8.2.1"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
